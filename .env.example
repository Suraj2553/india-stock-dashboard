# Market Monitor - environment configuration (copy to .env; setup does this for you)
# Everything here is OPTIONAL. The dashboard, engine, scans and TradingView data work with no keys at all.

# --- E-mail alerts (or fill these in the dashboard: Settings -> Scheduled scans & e-mail alerts) ---
# Gmail: turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# --- AI Chat provider (or pick one in the dashboard: Settings -> AI Chat provider) ---
# Default after setup is local Ollama (private - nothing leaves your machine). Cloud options, all with free tiers:
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1                          LLM_MODEL=llama-3.3-70b-versatile
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.5-flash
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1                             LLM_MODEL=openai/gpt-oss-120b:free
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1                                LLM_MODEL=mm-llama3.2   (no key)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
