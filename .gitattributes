# Keep Unix scripts runnable when cloned on Windows, and Windows scripts sane on Unix
*.sh          text eol=lf
Modelfile*    text eol=lf
*.py          text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.html        text eol=lf
*.bat         text eol=crlf
*.ps1         text eol=crlf
*.csv         text
*.zip         binary
